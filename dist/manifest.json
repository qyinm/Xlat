{
  "manifest_version": 3,
  "name": "Xlat Local Page Translator",
  "version": "0.2.0",
  "description": "Translate page and selected text locally with Chrome built-in Translator API.",
  "minimum_chrome_version": "138",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Xlat"
  },
  "options_page": "src/options/options.html",
  "icons": {},
  "web_accessible_resources": [
    {
      "resources": [
        "src/broker/broker.html",
        "src/broker/broker.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
